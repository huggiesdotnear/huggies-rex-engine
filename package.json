{
  "name": "@huggies/huggies-rex-engine-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "middleman"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:middleman": "bun run --filter @huggies/huggies-rex-engine-middleman build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "clean": "bun run --filter @huggies/huggies-rex-engine-middleman clean"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "@huggies/huggies-rex-engine-middleman": "workspace:*",
    "@near-kit-tool-box/fun": "0.3.0",
    "@near-kit-tool-box/web": "0.3.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@sleet-js/fastnear-explorer-api-client": "^0.1.5",
    "@sleet-js/intear-api-tool-box": "^0.1.1",
    "@sleet-js/middleman-intear-api": "0.1.0",
    "@sleet-js/middleman-intear-dex-api": "0.1.0",
    "@sleet-js/middleman-rhea-api": "0.1.1",
    "lucide-preact": "^1.59.0",
    "near-kit": "^0.20.2",
    "preact": "^11.0.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
