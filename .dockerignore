# ========================================
# .dockerignore — keep the build context small and the image cache useful.
#
# `node_modules` and `target` are rebuilt inside the image (bun install /
# cargo build), so shipping the host copies would only bloat the context
# and risk the image picking up host-platform binaries.
#
# `dist` is the middleman package's build output. it is rebuilt inside
# the image (the frontend imports the package by name, and the package
# resolves to `dist/index.js`), so the host copy would only be a stale
# artifact that the image overwrites anyway.
# ========================================
.git
.gitignore
node_modules
target
static
dist

# local env / editor noise
.env
.env.*
!.env.example
.DS_Store
*.swp
.idea
.vscode

# docs + docker files are not needed to build the image
DOCKER
DOCS
*.md
# --- WHY: frontend/llm.md is NOT ignored ---
# the markdown files are docs and do not belong in the image. but
# frontend/llm.md is the SOURCE of the served llms.txt — build.ts copies
# it to static/llms.txt — so the frontend stage needs it on disk, or the
# build fails on a missing /src/frontend/llm.md.
!frontend/llm.md
