# =====================
# bind host (default 0.0.0.0)
HUGGIES_HOST=0.0.0.0
# bind port (default 54733)
HUGGIES_PORT=54733
# =====================

# =====================
# the session secret.
#
# SECRET — never commit a real value. copy this file to `.env` and put
# a long random string here; `.env` is gitignored.
#
# it encrypts the session keys in the sqlite db. the app refuses to
# start without it.
#
# make one with: openssl rand -hex 32
#
# WARNING: changing it makes every existing session key unreadable.
# the db holds the keys encrypted with this value, so a new secret
# locks every signed-in user out until they sign in again.
# =====================
HUGGIES_SESSION_SECRET=
# =====================

# =====================
# cloudflare tunnel token.
#
# SECRET — never commit a real token. copy this file to `.env` and
# paste your tunnel token there; `.env` is gitignored.
#
# where to get it: cloudflare dashboard > Zero Trust > Networks >
# Tunnels > your tunnel > the docker install command shows
#   --token <THIS VALUE>
#
# the variable is named TUNNEL_TOKEN (not CLOUDFLARE_TUNNEL_TOKEN)
# because that is the name cloudflared itself reads from the
# environment, and docker-compose.yml hands this file to it verbatim
# via env_file. renaming it here would mean the container starts with
# an empty token.
# =====================
TUNNEL_TOKEN=
# =====================