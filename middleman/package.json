{
  "name": "@huggies/shit-1170-rex-engine-middleman",
  "version": "0.0.3",
  "description": "💩 middleman for interacting with shit-1170 agentic and defi engine",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/huggiesdotnear/shit-1170-rex-engine.git",
    "directory": "middleman"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:dry-run": "bun run scripts/version-sync.ts --dry-run",
    "release:version": "bun run scripts/release-version.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "//": "compatible with bun + tsc --build; emit ESM to dist/, publish dist + bin + README + LICENSE."
}
